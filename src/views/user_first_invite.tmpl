{{ $user := CurrentUser req }}
{{ $canInvite := and $user.HasOrganisation (UserCan $user "create" "team-user") }}
{{ $inviteTip := "Your role doesn't have permission to invite users" }}
{{ if not $user.HasOrganisation }}{{ $inviteTip = "Your account isn't part of an organisation" }}{{ end }}
<div class="private-portal-wrapper">
  <div class="container">
    <div class="card first-invite-card">
        <div class="card-body text-center d-flex flex-column align-content-center justify-content-center p-4">
            <h1 class="heading-large mb-3">You haven't yet invited any users to this organisation</h1>
                <p class="text-regular-14 text-default-subdue mb-4">
                    Get more work done by inviting someone to collaborate with
                </p>
                <div class="mb-3">
                    {{ if $canInvite }}
                    <a class="btn btn-primary" href="users/invite">
                          <i class="tyk-icon tykon tykon-plus"></i>
                         <span>Invite your first user</span>
                    </a>
                    {{ else }}
                    <span class="disabled-control" tabindex="0" data-toggle="tooltip" title="{{ $inviteTip }}">
                      <a class="btn btn-primary disabled" role="button" aria-disabled="true" tabindex="-1">
                            <i class="tyk-icon tykon tykon-plus"></i>
                           <span>Invite your first user</span>
                      </a>
                    </span>
                    {{ end }}
                </div>
              <p class="text-regular-14 text-default-subdue">
                 OR
                  <a href="#" class="breadcrumb-link"> Learn more</a>
                  <a href="#"><i class="bi bi-box-arrow-up-right learn-icon"></i></a>
              </p>
        </div>
    </div>
  </div>
</div>
